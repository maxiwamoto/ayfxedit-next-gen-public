#include <windows.h>
#include <commctrl.h>
1 ICON "assets/ayfx.ico"
2 DIALOGEX 0, 0, 300, 181
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Effect channels and loop"
FONT 9, "Segoe UI"
BEGIN
 RTEXT "Effect name", 1010, 10, 12, 55, 12
 EDITTEXT 1000, 71, 10, 219, 12, ES_AUTOHSCROLL
 LTEXT "Assign a bank track, or create a new blank channel.", -1, 10, 29, 280, 12
 RTEXT "Channel A", 1011, 10, 47, 55, 12
 COMBOBOX 1001, 71, 45, 219, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 RTEXT "Channel B", 1012, 10, 63, 55, 12
 COMBOBOX 1002, 71, 61, 219, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 RTEXT "Channel C", 1013, 10, 79, 55, 12
 COMBOBOX 1003, 71, 77, 219, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 CONTROL "Repeat loop during playback", 1004, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 97, 220, 14
 RTEXT "First frame", 1014, 10, 118, 55, 12
 EDITTEXT 1005, 71, 116, 48, 12, ES_NUMBER | ES_AUTOHSCROLL
 RTEXT "End (exclusive)", 1015, 155, 118, 80, 12
 EDITTEXT 1006, 242, 116, 48, 12, ES_NUMBER | ES_AUTOHSCROLL
 LTEXT "Decimal frames. Reassigned tracks keep their data.", -1, 10, 136, 280, 12
 DEFPUSHBUTTON "Apply", IDOK, 172, 155, 56, 18
 PUSHBUTTON "Cancel", IDCANCEL, 234, 155, 56, 18
END

3 DIALOGEX 0, 0, 450, 293
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WAV / MP3 to AY workshop"
FONT 9, "Segoe UI"
BEGIN
 PUSHBUTTON "Load audio...", 1100, 10, 10, 72, 18
 LTEXT "", 1102, 90, 10, 350, 26
 CONTROL "", 1101, "AYFXWave", WS_TABSTOP | WS_BORDER, 10, 38, 430, 62
 LTEXT "Drag to select.", -1, 10, 103, 82, 12
 PUSHBUTTON "Zoom selection", 1150, 96, 102, 80, 15
 PUSHBUTTON "Zoom out", 1151, 181, 102, 57, 15
 CONTROL "Spectrogram (80 Hz - 10 kHz)", 1152, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 252, 102, 188, 15
 RTEXT "Start (ms):", 1140, 10, 123, 44, 12
 EDITTEXT 1110, 57, 120, 44, 10, ES_NUMBER | ES_AUTOHSCROLL
 RTEXT "End (ms):", 1141, 121, 123, 40, 12
 EDITTEXT 1111, 164, 120, 44, 10, ES_NUMBER | ES_AUTOHSCROLL
 PUSHBUTTON "Full range", 1112, 227, 120, 59, 17
 RTEXT "Channels:", 1142, 298, 123, 43, 12
 COMBOBOX 1113, 343, 120, 35, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 CONTROL "Normalize", 1114, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 382, 121, 58, 16
 RTEXT "Fade-in (ms):", 1143, 10, 146, 58, 12
 EDITTEXT 1115, 71, 143, 36, 10, ES_NUMBER | ES_AUTOHSCROLL
 RTEXT "Fade-out (ms):", 1144, 136, 146, 64, 12
 EDITTEXT 1116, 203, 143, 36, 10, ES_NUMBER | ES_AUTOHSCROLL
 RTEXT "Pitch (semitones):", 1145, 270, 146, 83, 12
 COMBOBOX 1117, 360, 143, 80, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 RTEXT "Brightness:", -1, 10, 170, 51, 12
 RTEXT "Darker", -1, 93, 170, 34, 12
 CONTROL "", 1118, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 130, 163, 240, 23
 LTEXT "Brighter", -1, 380, 170, 60, 12
 LTEXT "0", 1119, 65, 170, 25, 12
 RTEXT "Tone sensitivity %:", 1155, 10, 192, 88, 12
 EDITTEXT 1153, 101, 189, 36, 12, ES_NUMBER | ES_AUTOHSCROLL
 RTEXT "Noise sensitivity %:", 1156, 240, 192, 96, 12
 EDITTEXT 1154, 339, 189, 36, 12, ES_NUMBER | ES_AUTOHSCROLL
 PUSHBUTTON "Convert", 1120, 10, 215, 92, 20
 PUSHBUTTON "Original", 1121, 109, 215, 68, 20
 PUSHBUTTON "AY result", 1122, 184, 215, 68, 20
 PUSHBUTTON "Stop", 1123, 259, 215, 53, 20
 PUSHBUTTON "Help", IDHELP, 387, 215, 53, 20
 LTEXT "", 1124, 10, 239, 430, 24
 RTEXT "Apply to:", 1146, 10, 270, 38, 12
 COMBOBOX 1125, 51, 267, 235, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 DEFPUSHBUTTON "Apply", IDOK, 301, 266, 66, 20
 PUSHBUTTON "Cancel", IDCANCEL, 374, 266, 66, 20
END

4 DIALOGEX 0, 0, 530, 306
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "AYFXEDIT - NEXT GEN | User guide"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Contents", 1200, 10, 9, 160, 12
 CONTROL "", 1201, "SysTreeView32", WS_TABSTOP | WS_BORDER | TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS, 10, 25, 158, 246
 CONTROL "", 1202, "RICHEDIT50W", WS_TABSTOP | WS_BORDER | WS_VSCROLL | ES_MULTILINE | ES_READONLY, 178, 10, 342, 261
 LTEXT "Select a topic. Use arrow keys to browse, or Tab to read and scroll.", 1203, 10, 282, 430, 16
 DEFPUSHBUTTON "Close", IDCANCEL, 454, 280, 66, 18
END

5 DIALOGEX 0, 0, 360, 236
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About AYFXEDIT - NEXT GEN"
FONT 9, "Segoe UI"
BEGIN
 ICON 1, -1, 12, 14, 24, 24
 LTEXT "AYFXEDIT - NEXT GEN", 1300, 46, 12, 302, 22
 LTEXT "By Max Iwamoto  |  OCT.22.2026", -1, 46, 39, 302, 12
 LTEXT "", 1301, 12, 61, 336, 26
 GROUPBOX "Based on", -1, 10, 90, 340, 64
 LTEXT "AY Sound FX Editor v0.6 - Shiru", -1, 20, 106, 318, 13
 LTEXT "ayfxedit-improved - Threetwosevensixseven", -1, 20, 124, 318, 13
 LTEXT "Original code and contributions remain credited to their respective authors. See Credits in the user guide for details.", -1, 12, 161, 336, 28
 PUSHBUTTON "Shiru's website", 1302, 12, 207, 86, 19
 PUSHBUTTON "Improved fork", 1303, 105, 207, 82, 19
 PUSHBUTTON "Credits", 1304, 194, 207, 70, 19
 DEFPUSHBUTTON "Close", IDCANCEL, 278, 207, 70, 19
END

6 DIALOGEX 0, 0, 400, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sound tools"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "", 1400, 12, 10, 376, 28
 PUSHBUTTON "Preview", 1401, 12, 271, 65, 18
 PUSHBUTTON "Stop", 1402, 84, 271, 50, 18
 PUSHBUTTON "Help", IDHELP, 141, 271, 50, 18
 DEFPUSHBUTTON "Apply", IDOK, 249, 271, 65, 18
 PUSHBUTTON "Cancel", IDCANCEL, 321, 271, 67, 18
END
